{
  "version": 2,
  "redirects": [
    { "source": "/join/:path*", "destination": "/", "permanent": true },
    { "source": "/landing/:path*", "destination": "/", "permanent": true }
  ],
  "routes": [
    { "src": "/privacy", "dest": "/privacy.html" },
    { "src": "/cat-percentile-predictor", "dest": "/cat-percentile-predictor.html" },
    { "src": "/mock-analysis", "dest": "/mock-analysis.html" },
    { "src": "/daily-rc/?", "dest": "/daily-rc/index.html" },
    { "src": "/daily-dilr/?", "dest": "/daily-dilr/index.html" },
    { "src": "/daily-qa/?", "dest": "/daily-qa/index.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
